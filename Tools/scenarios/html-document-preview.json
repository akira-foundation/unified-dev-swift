        "README.md": "# Gallery\n\nA scratch project for previewing documents.\n",
        "docs/report.html": "<!doctype html>\n<meta charset=\"utf-8\">\n<link rel=\"stylesheet\" href=\"app.css\">\n<h1>Relatorio com acentuacao: cafe, accao, mao</h1>\n<p id=\"violations\">policy violations: none yet</p>\n<p id=\"local\">local fetch: waiting</p>\n<p id=\"remote\">remote fetch: waiting</p>\n<p id=\"script\">remote script: waiting</p>\n<p id=\"secret\">withheld file: waiting</p>\n<p id=\"huge\">huge file: no huge.bin yet</p>\n<p>\n  <a href=\"other.html\">other file</a>\n  <a href=\"gallery/\">a folder</a>\n  <a href=\"draft &#35;2 at 100%.html\">an oddly named file</a>\n  <a href=\"../../../../etc/passwd\">climb out of the preview</a>\n  <a href=\"https://example.com\">a web link</a>\n  <a href=\"mailto:someone@example.com\">a mail link</a>\n</p>\n<p><button id=\"jump\">go to other.html by script</button></p>\n<form action=\"https://example.com\" method=\"get\"><button>submit a form</button></form>\n<iframe src=\"other.html\" height=\"60\" title=\"a local frame\"></iframe>\n<iframe src=\"https://example.com\" height=\"60\" title=\"a remote frame\"></iframe>\n<img src=\"https://example.com/favicon.ico\" onerror=\"this.alt='remote image blocked'\" alt=\"remote image loaded\">\n<script type=\"module\">\n  const seen = new Set();\n  addEventListener(\"securitypolicyviolation\", event => {\n    seen.add(event.violatedDirective);\n    document.querySelector(\"#violations\").textContent =\n      \"policy violations: \" + [...seen].sort().join(\", \");\n  });\n  fetch(\"data.json\").then(r => r.json())\n    .then(j => { document.querySelector(\"#local\").textContent = \"local fetch: \" + j.ok; });\n  fetch(\"https://example.com\").then(() => { document.querySelector(\"#remote\").textContent = \"remote fetch: LOADED\"; })\n    .catch(() => { document.querySelector(\"#remote\").textContent = \"remote fetch: blocked\"; });\n  fetch(\"../.env\").then(r => { document.querySelector(\"#secret\").textContent = \"withheld file: \" + r.status; })\n    .catch(() => { document.querySelector(\"#secret\").textContent = \"withheld file: blocked\"; });\n  fetch(\"huge.bin\").then(r => { document.querySelector(\"#huge\").textContent = \"huge file: \" + r.status; })\n    .catch(() => { document.querySelector(\"#huge\").textContent = \"huge file: no huge.bin yet\"; });\n  const s = document.createElement(\"script\");\n  s.src = \"https://cdn.jsdelivr.net/npm/lodash/lodash.min.js\";\n  s.onload = () => { document.querySelector(\"#script\").textContent = \"remote script: LOADED\"; };\n  s.onerror = () => { document.querySelector(\"#script\").textContent = \"remote script: blocked\"; };\n  document.head.append(s);\n  document.querySelector(\"#jump\").addEventListener(\"click\", () => { location.href = \"other.html\"; });\n</script>\n<div style=\"height: 3000px\"></div>\n<p id=\"bottom\">bottom of the page</p>\n",
