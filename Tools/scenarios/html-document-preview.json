        "README.md": "# Gallery\n\nA scratch project for previewing documents.\n",
        "docs/report.html": "<!doctype html>\n<meta charset=\"utf-8\">\n<link rel=\"stylesheet\" href=\"app.css\">\n<h1>Relatório com acentuação</h1>\n<p id=\"local\">local fetch: waiting</p>\n<p id=\"remote\">remote fetch: waiting</p>\n<p id=\"script\">remote script: waiting</p>\n<p><a href=\"other.html\">other file</a> <a href=\"https://example.com\">web</a></p>\n<img src=\"https://example.com/favicon.ico\" onerror=\"this.alt='remote image blocked'\" alt=\"remote image loaded\">\n<script type=\"module\">\n  fetch(\"data.json\").then(r => r.json()).then(j => { document.querySelector(\"#local\").textContent = \"local fetch: \" + j.ok; });\n  fetch(\"https://example.com\").then(() => { document.querySelector(\"#remote\").textContent = \"remote fetch: LOADED\"; })\n    .catch(() => { document.querySelector(\"#remote\").textContent = \"remote fetch: blocked\"; });\n  const s = document.createElement(\"script\");\n  s.src = \"https://cdn.jsdelivr.net/npm/lodash/lodash.min.js\";\n  s.onload = () => { document.querySelector(\"#script\").textContent = \"remote script: LOADED\"; };\n  s.onerror = () => { document.querySelector(\"#script\").textContent = \"remote script: blocked\"; };\n  document.head.append(s);\n</script>\n<div style=\"height: 3000px\"></div>\n<p id=\"bottom\">bottom of the page</p>\n",
